{
    "name": "reeds/reeds-sdk",
    "description": "The official PHP library for the Reeds APIs: one client for every Reeds service. Shipping: quotes, deliveries, labels, wallet, invoices and webhooks.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "reeds",
        "shipping",
        "delivery",
        "logistics",
        "nigeria",
        "api",
        "sdk",
        "webhooks",
        "laravel",
        "ecommerce"
    ],
    "homepage": "https://developer.getreeds.co",
    "authors": [
        {
            "name": "Reeds",
            "email": "support@getreeds.co",
            "homepage": "https://getreeds.co"
        }
    ],
    "support": {
        "email": "support@getreeds.co",
        "issues": "https://github.com/SendX-hq/reeds-php/issues",
        "source": "https://github.com/SendX-hq/reeds-php",
        "docs": "https://developer.getreeds.co"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.4 || ^8.0"
    },
    "require-dev": {
        "illuminate/config": "^10.0 || ^11.0 || ^12.0",
        "illuminate/container": "^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "suggest": {
        "illuminate/support": "To use the Laravel service provider and the Reeds facade"
    },
    "autoload": {
        "psr-4": {
            "Reeds\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Reeds\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Reeds\\Laravel\\ReedsServiceProvider"
            ],
            "aliases": {
                "Reeds": "Reeds\\Laravel\\Facades\\Reeds"
            }
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:e2e": "phpunit --testsuite e2e",
        "analyse": "phpstan analyse",
        "generate": "php scripts/generate.php"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "stable"
}
